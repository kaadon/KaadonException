{
    "name": "kaadon/exception",
    "description": "KaadonException - A PHP exception library providing enhanced exception handling capabilities",
    "type": "library",
    "keywords": ["exception", "error-handling", "php"],
    "license": "MIT",
    "authors": [
        {
            "name": "Kaadon",
            "email": "kaadon@example.com"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Kaadon\\Exception\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kaadon\\Exception\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    }
}